NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# NOTE: local Postgres from docker-compose.yml is mapped to host port 5433
DATABASE_URL=postgresql://amrutam:amrutam@localhost:5433/amrutam
# optional: without Redis, caching is skipped and rate limits are per-instance
REDIS_URL=redis://localhost:6379

# generate all secrets below with:  npm run gen-secrets
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12

# field-level encryption key ring:  v1:<64 hex chars>[,v2:<64 hex chars>]
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY_ID=v1

# true = DOCTOR and ADMIN routes require a session that passed the TOTP step
MFA_ENFORCE_STAFF=false
MFA_ISSUER=Amrutam

SLOT_HOLD_MINUTES=10
PATIENT_CANCEL_CUTOFF_MINUTES=60

TRUST_PROXY=0
RATE_LIMIT_ENABLED=true
CACHE_TTL_SECONDS=30

# if set, GET /metrics requires "Authorization: Bearer <token>"
METRICS_TOKEN=

OTEL_ENABLED=false
OTEL_SERVICE_NAME=amrutam-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

WORKER_POLL_MS=5000
WORKER_METRICS_PORT=9101
