{
  "info": {
    "name": "Amrutam Telemedicine API - demo flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the whole folder with the Collection Runner (right-click the collection, Run). Every request has tests, so a green run proves the flow works. Requires a running API and an admin user (npm run create-admin)."
  },
  "variable": [
    {
      "key": "rootUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "adminEmail",
      "value": "admin@amrutam.dev"
    },
    {
      "key": "adminPassword",
      "value": "Passw0rd!Admin"
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Readiness",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// start of a run: forget everything from the previous run",
                  "['adminToken','doctorToken','patientToken','doctorId','doctorEmail','patientEmail','slotId','consultationId','paymentId','bookKey','payKey','rxKey','runId'].forEach(function (k) { pm.collectionVariables.unset(k); });",
                  "pm.collectionVariables.set('runId', String(Date.now()));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('database is up', function () { pm.expect(pm.response.json().database).to.eql('up'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{rootUrl}}/health/ready",
            "description": "The URL of this request ignores {{baseUrl}}'s /api/v1 suffix on purpose (see the collection variable rootUrl)."
          }
        }
      ]
    },
    {
      "name": "1. Admin creates a doctor",
      "item": [
        {
          "name": "Admin login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('adminToken', pm.response.json().accessToken);",
                  "pm.test('got an access token', function () { pm.expect(pm.collectionVariables.get('adminToken')).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create doctor (ADMIN only)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('doctorEmail', 'doctor.' + pm.collectionVariables.get('runId') + '@amrutam.dev');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "var d = pm.response.json().doctor;",
                  "pm.collectionVariables.set('doctorId', d.doctor.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/doctors",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{doctorEmail}}\",\n  \"password\": \"Passw0rd!Doctor\",\n  \"fullName\": \"Dr Demo {{runId}}\",\n  \"specialization\": \"Cardiology\",\n  \"licenseNumber\": \"LIC-{{runId}}\",\n  \"experienceYears\": 12,\n  \"consultationFee\": 500,\n  \"bio\": \"Demo cardiologist\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "2. Doctor sets availability",
      "item": [
        {
          "name": "Doctor login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('doctorToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{doctorEmail}}\",\n  \"password\": \"Passw0rd!Doctor\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create a slot starting in 5 minutes",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var start = new Date(Date.now() + 5 * 60000);",
                  "pm.collectionVariables.set('slotStart', start.toISOString());",
                  "pm.collectionVariables.set('slotEnd', new Date(start.getTime() + 30 * 60000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('slotId', pm.response.json().slots[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{doctorToken}}"
              }
            ],
            "url": "{{baseUrl}}/slots",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slots\": [\n    {\n      \"startTime\": \"{{slotStart}}\",\n      \"endTime\": \"{{slotEnd}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Starts 5 minutes from now so the doctor is allowed to start the consultation later in this run (allowed from 10 minutes before)."
          }
        },
        {
          "name": "Doctor's own schedule",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('contains the new slot', function () { pm.expect(pm.response.json().slots.map(function (s) { return s.id; })).to.include(pm.collectionVariables.get('slotId')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doctorToken}}"
              }
            ],
            "url": "{{baseUrl}}/doctors/me/slots"
          }
        },
        {
          "name": "Overlapping slot is rejected by the database",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', function () { pm.response.to.have.status(409); });",
                  "pm.test('code is SLOT_OVERLAP', function () { pm.expect(pm.response.json().error.code).to.eql('SLOT_OVERLAP'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{doctorToken}}"
              }
            ],
            "url": "{{baseUrl}}/slots",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slots\": [\n    {\n      \"startTime\": \"{{slotStart}}\",\n      \"endTime\": \"{{slotEnd}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "3. Patient books and pays",
      "item": [
        {
          "name": "Register patient",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('patientEmail', 'patient.' + pm.collectionVariables.get('runId') + '@amrutam.dev');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('role is always PATIENT', function () { pm.expect(pm.response.json().user.role).to.eql('PATIENT'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"Passw0rd!Patient\",\n  \"fullName\": \"Demo Patient\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Patient login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('patientToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"Passw0rd!Patient\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Search doctors",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('finds the doctor', function () { pm.expect(pm.response.json().items.map(function (d) { return d.id; })).to.include(pm.collectionVariables.get('doctorId')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              }
            ],
            "url": "{{baseUrl}}/doctors?q={{runId}}&specialization=Cardiology&sort=fee_asc"
          }
        },
        {
          "name": "Doctor's open slots",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('slot is open', function () { pm.expect(pm.response.json().slots.map(function (s) { return s.id; })).to.include(pm.collectionVariables.get('slotId')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              }
            ],
            "url": "{{baseUrl}}/doctors/{{doctorId}}/slots"
          }
        },
        {
          "name": "Book WITHOUT Idempotency-Key (rejected)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('code is IDEMPOTENCY_KEY_REQUIRED', function () { pm.expect(pm.response.json().error.code).to.eql('IDEMPOTENCY_KEY_REQUIRED'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              }
            ],
            "url": "{{baseUrl}}/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"{{slotId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Book the slot (holds it for 10 minutes)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('bookKey')) { pm.collectionVariables.set('bookKey', pm.variables.replaceIn('{{$guid}}')); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "var b = pm.response.json();",
                  "pm.collectionVariables.set('consultationId', b.consultation.id);",
                  "pm.collectionVariables.set('paymentId', b.payment.id);",
                  "pm.test('waiting for payment', function () { pm.expect(b.consultation.status).to.eql('PENDING_PAYMENT'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{bookKey}}"
              }
            ],
            "url": "{{baseUrl}}/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"{{slotId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Send the SAME booking again (idempotent replay)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('bookKey')) { pm.collectionVariables.set('bookKey', pm.variables.replaceIn('{{$guid}}')); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('marked as a replay', function () { pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true'); });",
                  "pm.test('same consultation, no duplicate', function () { pm.expect(pm.response.json().consultation.id).to.eql(pm.collectionVariables.get('consultationId')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{bookKey}}"
              }
            ],
            "url": "{{baseUrl}}/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"{{slotId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Same key, same body: the stored response is returned and nothing new is created."
          }
        },
        {
          "name": "Same key, DIFFERENT body (rejected)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('bookKey')) { pm.collectionVariables.set('bookKey', pm.variables.replaceIn('{{$guid}}')); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', function () { pm.response.to.have.status(422); });",
                  "pm.test('code is IDEMPOTENCY_KEY_REUSED', function () { pm.expect(pm.response.json().error.code).to.eql('IDEMPOTENCY_KEY_REUSED'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{bookKey}}"
              }
            ],
            "url": "{{baseUrl}}/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"00000000-0000-4000-8000-000000000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Pay (mock gateway, success)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('payKey')) { pm.collectionVariables.set('payKey', pm.variables.replaceIn('{{$guid}}')); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "var r = pm.response.json();",
                  "pm.test('consultation is CONFIRMED', function () { pm.expect(r.consultation.status).to.eql('CONFIRMED'); });",
                  "pm.test('payment SUCCEEDED', function () { pm.expect(r.payment.status).to.eql('SUCCEEDED'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{payKey}}"
              }
            ],
            "url": "{{baseUrl}}/payments/{{paymentId}}/pay",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcome\": \"success\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Patient cannot create slots (RBAC)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 403', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              }
            ],
            "url": "{{baseUrl}}/slots",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slots\": [\n    {\n      \"startTime\": \"{{slotStart}}\",\n      \"endTime\": \"{{slotEnd}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "4. Doctor runs the consultation",
      "item": [
        {
          "name": "Start consultation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('IN_PROGRESS', function () { pm.expect(pm.response.json().consultation.status).to.eql('IN_PROGRESS'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doctorToken}}"
              }
            ],
            "url": "{{baseUrl}}/consultations/{{consultationId}}/start"
          }
        },
        {
          "name": "Issue prescription (encrypted at rest)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('rxKey')) { pm.collectionVariables.set('rxKey', pm.variables.replaceIn('{{$guid}}')); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{doctorToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{rxKey}}"
              }
            ],
            "url": "{{baseUrl}}/consultations/{{consultationId}}/prescription",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"diagnosis\": \"Mild hypertension\",\n  \"medications\": [\n    {\n      \"name\": \"Amlodipine\",\n      \"dosage\": \"5 mg\",\n      \"frequency\": \"Once daily\",\n      \"durationDays\": 30\n    }\n  ],\n  \"advice\": \"Reduce salt intake\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Complete consultation with private notes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('COMPLETED', function () { pm.expect(pm.response.json().consultation.status).to.eql('COMPLETED'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{doctorToken}}"
              }
            ],
            "url": "{{baseUrl}}/consultations/{{consultationId}}/complete",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Patient advised rest and regular blood pressure checks.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "5. Patient reads the results",
      "item": [
        {
          "name": "My consultations",
          "event": [
            {
              "listen": "test",
